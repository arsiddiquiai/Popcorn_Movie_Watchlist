# Copy to .env and fill in real values locally. Never commit .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=
# Optional — used for auth email redirect links (e.g. password reset).
# Falls back to the browser's current origin if unset, so this is only
# needed if the deployed app URL differs from that (e.g. behind a proxy).
VITE_APP_URL=
