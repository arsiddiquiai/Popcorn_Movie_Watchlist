# Copy to .env and fill in real values locally. Never commit .env.

# --- Browser (Vite inlines these into the client bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=
# Optional — used for auth email redirect links (e.g. password reset).
# Falls back to the browser's current origin if unset, so this is only
# needed if the deployed app URL differs from that (e.g. behind a proxy).
VITE_APP_URL=

# --- Server-side only (the /ai function: netlify/functions/ai.ts on
#     Netlify, api/ai.ts on Vercel — same code, same env vars either way) ---
# NEVER prefix this with VITE_. Vite inlines every VITE_-prefixed variable
# into the client bundle, which would publish the key to every visitor.
# Set this in whichever dashboard(s) are actually deploying the site; it's
# only needed locally if you run the function via `netlify dev` or
# `vercel dev`.
ANTHROPIC_API_KEY=
# The function reads Supabase/TMDB config from these unprefixed names first
# and falls back to the VITE_ ones above, so they normally don't need setting.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# TMDB_API_KEY=

# Server-side only — feedback + error-alert email (Resend).
# No VITE_ fallback on purpose: a VITE_-prefixed value would be inlined into
# the client bundle by Vite.
RESEND_API_KEY=
MY_NOTIFICATION_EMAIL=
# Optional: verified Resend sender. Defaults to onboarding@resend.dev, which
# can only deliver to the Resend account owner until a domain is verified.
RESEND_FROM=

# Server-side only — base64 32-byte key for AES-256-GCM encryption of
# per-user Anthropic API keys (BYOK). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=

# Server-side only — Supabase's service-role key. Bypasses RLS entirely, so
# treat it like a master password: never prefix with VITE_, never expose to
# the client. Used by server/serviceClient.ts for exactly three things:
# decrypting a saved BYOK key (server/byok.ts), deleting an auth.users row
# on account deletion (api/delete-account.ts), and serving the public
# /w/{token} share page for an anonymous visitor (api/share.ts). Find it in
# Supabase's dashboard under Project Settings -> API -> service_role secret
# — NOT the anon/public key used everywhere else in this file.
SUPABASE_SERVICE_ROLE_KEY=
