# Copy to .env and fill in real values locally. Never commit .env.

# --- Browser (Vite inlines these into the client bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TMDB_API_KEY=
# Optional — used for auth email redirect links (e.g. password reset).
# Falls back to the browser's current origin if unset, so this is only
# needed if the deployed app URL differs from that (e.g. behind a proxy).
VITE_APP_URL=

# --- Server-side only (Netlify Functions) ---
# NEVER prefix this with VITE_. Vite inlines every VITE_-prefixed variable
# into the client bundle, which would publish the key to every visitor.
# Set this in the Netlify dashboard; it is only needed locally if you run
# the function via `netlify dev`.
ANTHROPIC_API_KEY=
# The function reads Supabase/TMDB config from these unprefixed names first
# and falls back to the VITE_ ones above, so they normally don't need setting.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# TMDB_API_KEY=
