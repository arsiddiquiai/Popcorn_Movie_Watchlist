{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "functions": {
    "api/ai.ts": {
      "maxDuration": 30
    },
    "api/feedback.ts": {
      "maxDuration": 15
    }
  },

  "rewrites": [
    { "source": "/ai", "destination": "/api/ai" },
    { "source": "/feedback", "destination": "/api/feedback" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
